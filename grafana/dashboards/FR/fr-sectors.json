          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "SELECT period_date AS time, value FROM price_index WHERE country_iso3='FRA' AND indicator='construction_production_index' AND source='eurostat' AND period_date >= '2000-01-01' AND $__timeFilter(period_date) ORDER BY 1",
          "format": "time_series",
          "editorMode": "code"
        }
