    {
      "id": 9,
      "type": "timeseries",
      "title": "USD vs emerging currencies, indexed to 100 at range start",
      "description": "Rising line = currency weakening against the dollar.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nWITH base AS (\n  SELECT quote, rate AS r0 FROM fx_rate\n  WHERE base='USD' AND source='frankfurter' AND quote IN ('EUR','GBP','JPY','TRY','CHF','CNY')\n    AND ts = (SELECT min(ts) FROM fx_rate WHERE base='USD' AND source='frankfurter' AND $__timeFilter(ts))\n)\nSELECT f.ts AS time, 'USD/' || f.quote AS metric, 100 * f.rate / b.r0 AS value\nFROM fx_rate f JOIN base b ON b.quote = f.quote\nWHERE f.base='USD' AND f.source='frankfurter' AND $__timeFilter(f.ts) ORDER BY 1\n",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
