      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT count(*) FILTER (WHERE NOT ok) AS \"failing\"\nFROM (SELECT DISTINCT ON (source) source, ok FROM collector_run ORDER BY source, started_at DESC) t\n",
          "format": "table",
          "editorMode": "code"
