    {
      "id": 3,
      "type": "stat",
      "title": "Rows written, 24 h",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT sum(rows) AS \"rows\" FROM collector_run WHERE ok AND started_at > now() - interval '24 hours'\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {},
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Last run per source",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT DISTINCT ON (source)\n  source AS \"Source\",\n  started_at AS \"Last run\",\n  CASE WHEN ok THEN 'ok' ELSE 'error' END AS \"Status\",\n  rows AS \"Rows\",\n  round(extract(epoch FROM (finished_at - started_at))::numeric, 1) AS \"Seconds\",\n  error AS \"Error\"\nFROM collector_run\nORDER BY source, started_at DESC\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Source",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "#0ca30c",
                        "index": 0
                      },
                      "error": {
                        "color": "#d03b3b",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last run"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rows written per hour by source",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT $__timeGroupAlias(started_at, '1h'), source AS metric, sum(rows) AS value\nFROM collector_run\nWHERE $__timeFilter(started_at) AND ok\nGROUP BY 1, 2 ORDER BY 1\n",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 60,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": 3600000,
            "axisBorderShow": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
