{
  "uid": "collector-health",
  "title": "Collector Health",
  "description": "What the collector has been doing: last result per source, rows written, failures.",
  "tags": [
    "ops"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "style": "dark",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "lyraqpi",
      "tags": [],
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
