      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "SELECT city || ' ' || round(temp_c,1) || '°C' AS hottest FROM (SELECT DISTINCT ON (city) city, temp_c FROM weather_current WHERE ts > now() - interval '3 hours' ORDER BY city, ts DESC) t ORDER BY temp_c DESC LIMIT 1",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
