    {
      "id": 7,
      "type": "geomap",
      "title": "World right now — city temperatures, earthquakes (24 h, M2.5+), ISS, live aircraft",
      "description": "Cities coloured by current temperature. Earthquake bubbles sized and coloured by magnitude. Star = International Space Station. Small dots = aircraft over Europe (OpenSky), latest snapshot — toggle the layer off in the panel legend if it's too busy.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "cities",
          "rawQuery": true,
          "rawSql": "\nSELECT DISTINCT ON (w.city)\n  w.city AS \"City\", c.lat, c.lon,\n  w.temp_c AS \"Temp °C\", w.humidity AS \"Humidity %\", w.wind_kph AS \"Wind km/h\",\n  w.aqi_eu AS \"AQI\", w.ts AS \"Observed\"\nFROM weather_current w JOIN city c ON c.city = w.city\nWHERE w.ts > now() - interval '3 hours'\nORDER BY w.city, w.ts DESC\n",
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "quakes",
          "rawQuery": true,
          "rawSql": "\nSELECT ts AS \"Time\", lat, lon, mag AS \"Magnitude\", depth_km AS \"Depth km\", place AS \"Place\", source\nFROM earthquake\nWHERE ts > now() - interval '24 hours' AND mag >= 2.5\nORDER BY ts DESC\n",
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "iss",
          "rawQuery": true,
          "rawSql": "\nSELECT ts AS \"Time\", lat, lon, altitude_km AS \"Altitude km\", velocity_kmh AS \"Velocity km/h\", 'ISS' AS name\nFROM iss_position ORDER BY ts DESC LIMIT 1\n",
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "aircraft",
          "rawQuery": true,
          "rawSql": "\nSELECT icao24, callsign, country AS \"Country\", lat, lon, alt_m AS \"Altitude m\", heading\nFROM aircraft_state\nWHERE ts = (SELECT max(ts) FROM aircraft_state) AND lat IS NOT NULL AND lon IS NOT NULL\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "view": {
          "id": "zero",
          "lat": 25,
          "lon": 15,
          "zoom": 1.7,
          "allLayers": true
        },
        "controls": {
