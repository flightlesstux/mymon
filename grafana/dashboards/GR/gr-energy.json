          "rawQuery": true,
          "rawSql": "SELECT period_date AS time, value FROM price_index WHERE country_iso3='GRC' AND indicator='gas_price_eur_per_kwh' AND source='eurostat' AND period_date >= '2000-01-01' AND $__timeFilter(period_date) ORDER BY 1",
