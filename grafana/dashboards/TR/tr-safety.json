    {
      "id": 4,
      "type": "timeseries",
      "title": "Turkey: recorded crime rate by offence (per 100,000 inhabitants)",
      "description": "Eurostat crim_off_cat, harmonized ICCS offence categories, annual since 2008. Not every category is reported by every country every year.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\n    SELECT period_date AS time, CASE indicator WHEN 'crime_rate_per_100k_homicide' THEN 'Homicide' WHEN 'crime_rate_per_100k_robbery' THEN 'Robbery' WHEN 'crime_rate_per_100k_burglary' THEN 'Burglary' WHEN 'crime_rate_per_100k_theft' THEN 'Theft' WHEN 'crime_rate_per_100k_drug_offences' THEN 'Drug offences' WHEN 'crime_rate_per_100k_fraud' THEN 'Fraud' ELSE indicator END AS metric, value\n    FROM price_index\n    WHERE country_iso3='TUR' AND source='eurostat' AND indicator IN ('crime_rate_per_100k_homicide','crime_rate_per_100k_robbery','crime_rate_per_100k_burglary','crime_rate_per_100k_theft','crime_rate_per_100k_drug_offences','crime_rate_per_100k_fraud')\n      AND period_date >= '2000-01-01' AND $__timeFilter(period_date)\n    ORDER BY 1\n    ",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
