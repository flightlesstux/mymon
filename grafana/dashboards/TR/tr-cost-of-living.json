  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Turkey: CPI by spending category (2015=100)",
      "description": "All 12 top-level COICOP categories Eurostat splits the CPI into.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\n    SELECT period_date AS time, CASE indicator WHEN 'cpi_cat_food_and_drink' THEN 'Food & non-alc. drink' WHEN 'cpi_cat_alcohol_and_tobacco' THEN 'Alcohol & tobacco' WHEN 'cpi_cat_clothing_and_footwear' THEN 'Clothing & footwear' WHEN 'cpi_cat_housing_water_energy' THEN 'Housing, water & energy' WHEN 'cpi_cat_furnishings_household' THEN 'Furnishings & household' WHEN 'cpi_cat_health' THEN 'Health' WHEN 'cpi_cat_transport' THEN 'Transport' WHEN 'cpi_cat_communication' THEN 'Communication' WHEN 'cpi_cat_recreation_and_culture' THEN 'Recreation & culture' WHEN 'cpi_cat_education' THEN 'Education' WHEN 'cpi_cat_restaurants_and_hotels' THEN 'Restaurants & hotels' WHEN 'cpi_cat_misc_goods_and_services' THEN 'Misc. goods & services' ELSE indicator END AS metric, value\n    FROM price_index\n    WHERE country_iso3='TUR' AND source='eurostat' AND indicator IN ('cpi_cat_food_and_drink','cpi_cat_alcohol_and_tobacco','cpi_cat_clothing_and_footwear','cpi_cat_housing_water_energy','cpi_cat_furnishings_household','cpi_cat_health','cpi_cat_transport','cpi_cat_communication','cpi_cat_recreation_and_culture','cpi_cat_education','cpi_cat_restaurants_and_hotels','cpi_cat_misc_goods_and_services')\n      AND period_date >= '2000-01-01' AND $__timeFilter(period_date)\n    ORDER BY 1\n    ",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "calcs": []
