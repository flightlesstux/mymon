    {
      "id": 11,
      "type": "timeseries",
      "title": "Bankruptcies by sector",
      "description": "CBS 82244NED, 13 top-level SBI sectors, monthly since 2009.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT period_date AS time,\n       CASE indicator\n         WHEN 'bankruptcies_sector_agriculture' THEN 'Agriculture' WHEN 'bankruptcies_sector_industry' THEN 'Industry' WHEN 'bankruptcies_sector_construction' THEN 'Construction' WHEN 'bankruptcies_sector_trade' THEN 'Trade' WHEN 'bankruptcies_sector_transport' THEN 'Transport' WHEN 'bankruptcies_sector_hospitality' THEN 'Hospitality' WHEN 'bankruptcies_sector_ict' THEN 'ICT' WHEN 'bankruptcies_sector_finance' THEN 'Finance' WHEN 'bankruptcies_sector_real_estate' THEN 'Real estate' WHEN 'bankruptcies_sector_business_services' THEN 'Business services' WHEN 'bankruptcies_sector_other_business_services' THEN 'Other business services' WHEN 'bankruptcies_sector_healthcare' THEN 'Healthcare' WHEN 'bankruptcies_sector_culture_sport_recreation' THEN 'Culture, sport & recreation'\n         ELSE indicator\n       END AS metric, value\nFROM price_index\nWHERE country_iso3='NLD' AND source='cbs'\n  AND indicator IN ('bankruptcies_sector_agriculture','bankruptcies_sector_industry','bankruptcies_sector_construction','bankruptcies_sector_trade','bankruptcies_sector_transport','bankruptcies_sector_hospitality','bankruptcies_sector_ict','bankruptcies_sector_finance','bankruptcies_sector_real_estate','bankruptcies_sector_business_services','bankruptcies_sector_other_business_services','bankruptcies_sector_healthcare','bankruptcies_sector_culture_sport_recreation')\n  AND $__timeFilter(period_date)\nORDER BY 1\n",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
