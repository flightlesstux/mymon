  "panels": [
    {
      "id": 1,
      "type": "geomap",
      "title": "Netherlands — current temperature",
      "description": "Amsterdam, Rotterdam, The Hague, Utrecht, Eindhoven — latest reading.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "cities",
          "rawQuery": true,
          "rawSql": "\nSELECT DISTINCT ON (w.city)\n  w.city AS \"City\", c.lat, c.lon, w.temp_c AS \"Temp °C\", w.feels_like_c AS \"Feels °C\",\n  w.humidity AS \"Humidity %\", w.wind_kph AS \"Wind km/h\", w.pressure_hpa AS \"Pressure hPa\",\n  w.aqi_eu AS \"AQI\", w.pm2_5 AS \"PM2.5\", w.pm10 AS \"PM10\", w.ts AS \"Observed\"\nFROM weather_current w JOIN city c ON c.city = w.city\nWHERE w.city IN ('Amsterdam','Rotterdam','The Hague','Utrecht','Eindhoven') AND w.ts > now() - interval '3 hours'\nORDER BY w.city, w.ts DESC\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 52.1,
          "lon": 5.1,
          "zoom": 7.3,
          "allLayers": true
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": false,
          "showAttribution": true,
          "showScale": false,
          "showMeasure": false,
          "showDebug": false
        },
        "basemap": {
          "type": "osm-standard",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Cities (temperature)",
            "config": {
              "style": {
                "size": {
                  "fixed": 16,
                  "min": 16,
                  "max": 16
                },
                "color": {
                  "field": "Temp °C",
                  "fixed": "#3987e5"
                },
                "opacity": 0.95,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "symbolAlign": {
                  "horizontal": "center",
                  "vertical": "center"
                },
                "rotation": {
                  "fixed": 0,
                  "mode": "mod",
                  "min": -360,
                  "max": 360
                },
                "textConfig": {
                  "fontSize": 11,
                  "offsetX": 0,
                  "offsetY": 12,
                  "textAlign": "center",
                  "textBaseline": "middle"
                },
                "text": {
                  "field": "City",
                  "fixed": "",
                  "mode": "field"
                }
              },
              "showLegend": false
            },
            "location": {
              "mode": "auto"
            },
            "filterData": {
              "id": "byRefId",
              "options": "cities"
            },
            "tooltip": true,
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "continuous-BlYlRd"
                },
                "min": -5,
                "max": 30
              },
              "overrides": []
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      }
    },
