    {
      "id": 3,
      "type": "timeseries",
      "title": "Daily average temperature",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT $__timeGroupAlias(ts, '1d'), city AS metric, avg(temp_c) AS value\nFROM weather_current\nWHERE city IN ('Amsterdam','Rotterdam','The Hague','Utrecht','Eindhoven') AND ts >= '2000-01-01' AND $__timeFilter(ts)\nGROUP BY 1, 2 ORDER BY 1\n",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
