{
  "uid": "nl-stocks",
  "title": "NL: Companies on US Exchanges",
  "description": "Daily closes for Dutch-domiciled (N.V.) companies listed on NASDAQ/NYSE: ASML, ING, Philips, NXP Semiconductors, Stellantis, LyondellBasell and Qiagen, since 2000 where the listing goes back that far.",
  "tags": [
    "netherlands"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
