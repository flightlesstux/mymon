  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Latest session, all 7 companies",
      "description": "Dutch-domiciled (N.V.) companies listed on NASDAQ/NYSE — not Shell or Unilever, both of which redomiciled to the UK.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT name AS \"Company\", symbol AS \"Symbol\", close AS \"Close (USD)\",\n       round(100 * (close - prev_close) / prev_close, 2) AS \"Change %\", day AS \"Session\"\nFROM (\n    SELECT *, LAG(close) OVER (PARTITION BY symbol ORDER BY day) AS prev_close,\n           ROW_NUMBER() OVER (PARTITION BY symbol ORDER BY day DESC) AS rn\n    FROM nl_us_stock WHERE source='yahoo_finance'\n) t\nWHERE rn = 1\nORDER BY \"Change %\" DESC\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Change %",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Share price performance, indexed to 100 at range start",
      "description": "Every company on one axis regardless of raw price — ASML trades around $1,600, Qiagen around $42; a shared price axis would flatten the cheaper stocks.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT day AS time, symbol AS metric,\n       close / first_value(close) OVER (PARTITION BY symbol ORDER BY day) * 100 AS value\nFROM nl_us_stock\nWHERE source='yahoo_finance' AND $__timeFilter(day)\nORDER BY 1\n",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "calcs": []
