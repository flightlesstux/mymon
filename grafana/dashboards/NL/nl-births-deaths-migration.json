    {
      "id": 9,
      "type": "timeseries",
      "title": "Net migration, per month (immigration − emigration)",
      "description": "Positive = more people moved to NL than left, that month.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT im.period_date AS time, im.value - em.value AS value\nFROM price_index im JOIN price_index em\n  ON em.period_date = im.period_date AND em.country_iso3 = im.country_iso3 AND em.source = im.source\nWHERE im.country_iso3='NLD' AND im.source='cbs' AND im.indicator='immigration' AND em.indicator='emigration'\n  AND $__timeFilter(im.period_date)\nORDER BY 1\n",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
