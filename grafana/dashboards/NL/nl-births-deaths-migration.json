      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT period_date AS time, indicator AS metric, value FROM price_index\nWHERE country_iso3='NLD' AND source='cbs' AND indicator IN ('births','deaths')\n  AND $__timeFilter(period_date) ORDER BY 1\n",
          "format": "time_series",
