    {
      "id": 8,
      "type": "timeseries",
      "title": "Fuel type share of fleet",
      "description": "Same data as a share of the total fleet each year.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT p.period_date AS time, p.indicator AS metric,\n       round((100 * p.value / NULLIF(total.value, 0))::numeric, 2) AS value\nFROM price_index p\nJOIN (SELECT period_date, value FROM price_index\n      WHERE country_iso3='NLD' AND source='cbs' AND indicator='vehicle_fleet_total') total\n  ON total.period_date = p.period_date\nWHERE p.country_iso3='NLD' AND p.source='cbs'\n  AND p.indicator IN ('vehicle_fleet_petrol','vehicle_fleet_diesel','vehicle_fleet_lpg',\n                       'vehicle_fleet_electric','vehicle_fleet_cng')\n  AND $__timeFilter(p.period_date)\nORDER BY 1\n",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": 3600000,
            "axisBorderShow": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "vehicle_fleet_petrol"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "vehicle_fleet_diesel"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
