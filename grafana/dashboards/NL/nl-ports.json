          "rawSql": "\nSELECT period_date AS time,\n       regexp_replace(indicator, '^freight_total_mt_', '') AS metric, value\nFROM price_index\nWHERE country_iso3='NLD' AND source='cbs' AND indicator LIKE 'freight_total_mt_%'\n  AND $__timeFilter(period_date)\nORDER BY 1\n",
