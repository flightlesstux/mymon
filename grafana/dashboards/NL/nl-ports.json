    {
      "id": 5,
      "type": "geomap",
      "title": "Cargo by port, latest quarter",
      "description": "CBS 85598NED, gross cargo tonnage per Dutch seaport.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT DISTINCT ON (m.port_code) p.name AS \"Port\", p.lat, p.lon,\n       m.value AS \"Cargo, 1000t\", m.period_date AS \"Period\"\nFROM port_metric m JOIN port p ON p.code = m.port_code\nWHERE m.indicator='cargo_1000t' AND m.source='cbs'\nORDER BY m.port_code, m.period_date DESC\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 52.1,
          "lon": 5.0,
          "zoom": 7.0,
          "allLayers": true
