                  "fixed": 10,
                  "min": 10,
                  "max": 32,
                  "field": "Avg price EUR"
                },
                "color": {
                  "field": "Avg price EUR",
                  "fixed": "#3987e5"
                },
                "opacity": 0.85,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "symbolAlign": {
                  "horizontal": "center",
                  "vertical": "center"
                },
                "rotation": {
                  "fixed": 0,
                  "mode": "mod",
                  "min": -360,
                  "max": 360
                },
                "textConfig": {
                  "fontSize": 11,
                  "offsetX": 0,
                  "offsetY": 12,
                  "textAlign": "center",
                  "textBaseline": "middle"
                },
                "text": {
                  "field": "Province",
                  "fixed": "",
                  "mode": "field"
                }
              },
              "showLegend": false
            },
            "location": {
              "mode": "auto"
            },
            "filterData": {
              "id": "byRefId",
