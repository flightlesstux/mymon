    {
      "id": 1,
      "type": "stat",
      "title": "Aircraft over NL right now",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT count(*) AS aircraft FROM aircraft_state\nWHERE ts = (SELECT max(ts) FROM aircraft_state) AND lat BETWEEN 50.6 AND 53.7 AND lon BETWEEN 3.2 AND 7.3\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
