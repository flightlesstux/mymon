    {
      "id": 4,
      "type": "geomap",
      "title": "Aircraft currently over the Netherlands",
      "description": "OpenSky Network, latest snapshot (live only, no historical query).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "aircraft",
          "rawQuery": true,
          "rawSql": "\nSELECT icao24, callsign, country AS \"Country\", lat, lon, alt_m AS \"Altitude m\",\n       velocity AS \"Speed m/s\", heading\nFROM aircraft_state\nWHERE ts = (SELECT max(ts) FROM aircraft_state) AND lat BETWEEN 50.6 AND 53.7 AND lon BETWEEN 3.2 AND 7.3\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 52.1,
          "lon": 5.1,
          "zoom": 7.3,
          "allLayers": true
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": false,
          "showAttribution": true,
          "showScale": false,
          "showMeasure": false,
          "showDebug": false
        },
        "basemap": {
          "type": "osm-standard",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Aircraft",
            "config": {
              "style": {
                "size": {
                  "fixed": 5,
                  "min": 5,
                  "max": 5
                },
                "color": {
                  "fixed": "#199e70"
                },
                "opacity": 0.85,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "symbolAlign": {
                  "horizontal": "center",
                  "vertical": "center"
                },
                "rotation": {
                  "fixed": 0,
                  "mode": "mod",
                  "min": -360,
                  "max": 360
                },
                "textConfig": {
                  "fontSize": 11,
                  "offsetX": 0,
                  "offsetY": 12,
                  "textAlign": "center",
                  "textBaseline": "middle"
                },
                "text": {
                  "field": "callsign",
                  "fixed": "",
                  "mode": "field"
                }
              },
              "showLegend": false
            },
            "location": {
              "mode": "auto"
            },
            "filterData": {
              "id": "byRefId",
              "options": "aircraft"
            },
            "tooltip": true
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Aircraft count over NL, last 24 h",
      "description": "Day/night flight pattern — expect it to drop overnight.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT ts AS time, count(*) AS value FROM aircraft_state\nWHERE ts > now() - interval '24 hours' AND lat BETWEEN 50.6 AND 53.7 AND lon BETWEEN 3.2 AND 7.3\nGROUP BY ts ORDER BY ts\n",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": 3600000,
            "axisBorderShow": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "value"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Aircraft over NL now, by altitude",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT callsign AS \"Callsign\", country AS \"Country\", round(alt_m::numeric, 0) AS \"Altitude m\",\n       round(velocity::numeric, 0) AS \"Speed m/s\", round(heading::numeric, 0) AS \"Heading\"\nFROM aircraft_state\nWHERE ts = (SELECT max(ts) FROM aircraft_state) AND lat BETWEEN 50.6 AND 53.7 AND lon BETWEEN 3.2 AND 7.3 AND callsign IS NOT NULL\nORDER BY alt_m DESC NULLS LAST LIMIT 50\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Altitude m",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Altitude m"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Speed m/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocityms"
              }
            ]
          }
        ]
      }
    }
