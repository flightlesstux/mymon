      "title": "NS active train disruptions",
      "description": "Live-only (no historical API); shows 'No data' until NS_API_KEY is set — free instant signup at apiportal.ns.nl.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
