    {
      "id": 101,
      "type": "geomap",
      "title": "Total reserves incl. gold by country (World Bank, latest year)",
      "description": "Bubble size and colour = total reserves in USD. Source: World Bank FI.RES.TOTL.CD (annual).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT DISTINCT ON (r.country_iso3)\n  r.country AS \"Country\", r.value_usd AS \"Reserves USD\", c.lat, c.lon, r.period_date AS \"As of\"\nFROM reserves r JOIN country_centroid c ON c.iso3 = r.country_iso3\nWHERE r.metric = 'total' AND r.source = 'worldbank' AND r.value_usd IS NOT NULL\n  AND r.country_iso3 NOT IN ('WLD','EMU')\nORDER BY r.country_iso3, r.period_date DESC\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "view": {
          "id": "zero",
          "lat": 30,
          "lon": 20,
          "zoom": 1.5,
          "allLayers": true
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": false,
          "showAttribution": true,
          "showScale": false,
          "showMeasure": false,
          "showDebug": false
        },
        "basemap": {
          "type": "carto",
          "name": "Basemap",
          "config": {
            "theme": "dark",
            "showLabels": true
          }
        },
        "layers": [
          {
            "type": "markers",
            "name": "Reserves",
            "config": {
              "style": {
                "size": {
                  "fixed": 4,
                  "min": 4,
                  "max": 40,
                  "field": "Reserves USD"
                },
                "color": {
                  "field": "Reserves USD",
                  "fixed": "#3987e5"
                },
                "opacity": 0.7,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "symbolAlign": {
                  "horizontal": "center",
                  "vertical": "center"
                },
                "rotation": {
                  "fixed": 0,
                  "mode": "mod",
                  "min": -360,
                  "max": 360
                },
                "textConfig": {
                  "fontSize": 11,
                  "offsetX": 0,
                  "offsetY": 12,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              },
              "showLegend": false
            },
            "location": {
              "mode": "auto"
            },
            "filterData": {
              "id": "byRefId",
              "options": "A"
            },
            "tooltip": true,
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "continuous-BlPu"
                }
              },
              "overrides": []
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 102,
      "type": "barchart",
      "title": "Top 15 reserve holders",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT country AS \"Country\", value_usd AS \"Total reserves\"\nFROM (\n  SELECT DISTINCT ON (country_iso3) country, value_usd\n  FROM reserves\n  WHERE metric='total' AND source='worldbank' AND value_usd IS NOT NULL AND country_iso3 NOT IN ('WLD','EMU')\n  ORDER BY country_iso3, period_date DESC\n) t ORDER BY value_usd DESC LIMIT 15\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "barRadius": 0.1,
