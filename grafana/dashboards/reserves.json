    {
      "id": 110,
      "type": "barchart",
      "title": "Gold share of total reserves, %",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT country AS \"Country\", round(100 * gold / NULLIF(total,0), 1) AS \"Gold share %\"\nFROM (\n  SELECT DISTINCT ON (country_iso3) country_iso3, country, period_date,\n    max(value_usd) FILTER (WHERE metric='gold') OVER w AS gold,\n    max(value_usd) FILTER (WHERE metric='total') OVER w AS total\n  FROM reserves\n  WHERE source='worldbank' AND country_iso3 IN ('USA','DEU','ITA','FRA','RUS','CHN','CHE','JPN','IND','NLD','TUR','GBR','SAU','KOR','BRA')\n  WINDOW w AS (PARTITION BY country_iso3, period_date)\n  ORDER BY country_iso3, period_date DESC\n) t WHERE total > 0 ORDER BY 2 DESC\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "barRadius": 0.1,
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#c98500"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none",
            "axisBorderShow": false
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
