    {
      "id": 5,
      "type": "geomap",
      "title": "Free bikes right now, by city",
      "description": "CityBikes, 15 major-city networks — a curated set, not exhaustive (800+ networks exist worldwide).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mymon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mymon-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT DISTINCT ON (network_id) city AS \"City\", lat, lon, free_bikes AS \"Free bikes\",\n       empty_slots AS \"Empty docks\", stations AS \"Stations\", ts AS \"Updated\"\nFROM bike_network\nORDER BY network_id, ts DESC\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "view": {
          "id": "zero",
          "lat": 25,
          "lon": -10,
          "zoom": 2.2,
          "allLayers": true
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": false,
          "showAttribution": true,
          "showScale": false,
          "showMeasure": false,
          "showDebug": false
        },
        "basemap": {
          "type": "osm-standard",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Cities",
            "config": {
              "style": {
                "size": {
                  "fixed": 8,
                  "min": 8,
                  "max": 32,
                  "field": "Free bikes"
                },
                "color": {
                  "field": "Free bikes",
                  "fixed": "#3987e5"
                },
                "opacity": 0.85,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "symbolAlign": {
                  "horizontal": "center",
                  "vertical": "center"
                },
                "rotation": {
                  "fixed": 0,
                  "mode": "mod",
                  "min": -360,
                  "max": 360
                },
                "textConfig": {
                  "fontSize": 11,
                  "offsetX": 0,
                  "offsetY": 12,
                  "textAlign": "center",
                  "textBaseline": "middle"
                },
                "text": {
                  "field": "City",
                  "fixed": "",
                  "mode": "field"
                }
              },
              "showLegend": false
            },
            "location": {
              "mode": "auto"
            },
            "filterData": {
              "id": "byRefId",
              "options": "A"
            },
            "tooltip": true,
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "continuous-GnYlRd"
                }
              },
              "overrides": []
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      }
