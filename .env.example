# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=mymon
POSTGRES_USER=mymon
POSTGRES_PASSWORD=change-me-writer
# Read-only role used by Grafana (anonymous viewers can run SQL through Grafana,
# so this role must never have write access).
POSTGRES_RO_USER=grafana_ro
POSTGRES_RO_PASSWORD=change-me-readonly

# --- Grafana ------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-admin
GRAFANA_ROOT_URL=https://lyraqpi.com
GRAFANA_DOMAIN=lyraqpi.com

# --- Optional API keys (phase 2 sources; module stays disabled if empty) --
#FRED_API_KEY=
#EVDS_API_KEY=
#EIA_API_KEY=
#OPENSKY_CLIENT_ID=
#OPENSKY_CLIENT_SECRET=
#EPIAS_USERNAME=
#EPIAS_PASSWORD=
# Free instant self-service signup, no cost: https://apiportal.ns.nl/
#NS_API_KEY=
